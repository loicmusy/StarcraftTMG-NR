!/package.json
!/update-official.test.mjs
!/wave4-leak-data.mjs
!/simulate-leak-import.mjs
!/assets/
!/assets/rule-leaks/
!/assets/rule-leaks/**
!/.agents/
!/.agents/skills/
!/.agents/skills/**
!/assets/rules/
!/assets/rules/**
!/leak-import.test.mjs
