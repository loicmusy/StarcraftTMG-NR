        </profile>
        <profile name="Freedom Fighters" id="7eea-7a20-dc9c-a25b" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">The Supply Value of all Friendly Units Within 8&quot; of this Unit cannot be reduced below 1 for Contesting Mission Markers and completing objectives.</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
          </characteristics>
        </profile>
        <profile name="Orders" id="5081-268f-12c4-02ef" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">REPEATABLE. Select another Friendly Biological Unit Within 8&quot;, spend CP and apply one of the following effects:
- 1 CP: That Unit’s first used weapon gains the CRITICAL HIT (2).
- 1 CP: That Unit ignores the Disengage penalty for the remainder of the Round.
- 2 CP: Remove the Activation Marker from that Unit.</characteristic>
            <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active (X CP)</characteristic>
          </characteristics>
        </profile>
