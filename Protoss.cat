  <sharedProfiles>
    <profile name="Quick Strikes" id="7995-a465-9333-17ea" hidden="false" typeId="f61d-0471-085d-248c" typeName="Rules (Combat Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="b94b-6a13-1240-6b8b">The active Unit’s first Close Combat Weapon used gains PRECISION (2).</characteristic>
        <characteristic name="Cost" typeId="6f0c-b621-2f03-fe52">Active</characteristic>
      </characteristics>
    </profile>
    <profile name="Strategic Recall" id="e3e8-f973-a8d1-16ef" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">The active, Unengaged Ground Unit is returned to Reserves instead of performing an action.</characteristic>
        <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active</characteristic>
      </characteristics>
    </profile>
    <profile name="Zealot" id="cec2-87db-e412-505f" hidden="false" typeId="18be-d8b9-8024-4925" typeName="Unit">
      <characteristics>
        <characteristic name="Shd" typeId="4301-e83c-7226-741a">3</characteristic>
        <characteristic name="Spd" typeId="1b39-d395-b125-7ea9">4/7</characteristic>
        <characteristic name="Eva" typeId="bc5e-a9b9-f09d-8dec">5+</characteristic>
        <characteristic name="Arm" typeId="08b0-2471-8408-9222">5+</characteristic>
        <characteristic name="HP" typeId="e275-f946-72ee-4a48">4</characteristic>
        <characteristic name="Size" typeId="357b-9a74-5a55-800e">2</characteristic>
        <characteristic name="Supply" typeId="4fa8-90ab-7d11-c8e3">1: 1 | 2-3: 2</characteristic>
      </characteristics>
    </profile>
    <profile name="Leg Enhancements" id="d28b-b20c-980e-26ed" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">This Unit performs a 2&quot; Move action. This does not count towards its action limit.</characteristic>
        <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active (1 PE)</characteristic>
      </characteristics>
    </profile>
    <profile name="Charge" id="c4c6-376a-082d-f63c" hidden="false" typeId="07ee-ef54-fbf7-5ca9" typeName="Rules (Assault Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="97a6-bd65-3d58-17e9">When determining Charge Distance for this Unit, roll 2D6 instead of D6 and use the higher result to add to the Unit’s Speed characteristic.</characteristic>
        <characteristic name="Cost" typeId="06d2-1c49-1cfc-44f5">Active (1 PE)</characteristic>
      </characteristics>
    </profile>
    <profile name="Psi Blades" id="76e4-fa8c-6eac-1990" hidden="false" typeId="7b96-11fe-e87a-e61c" typeName="Combat Weapon">
      <characteristics>
        <characteristic name="Rng" typeId="f6d9-ff21-6fe9-b821">E</characteristic>
        <characteristic name="Tgt" typeId="0bf8-6c63-e593-8417">Ground</characteristic>
        <characteristic name="RoA" typeId="af32-03e6-6c32-3580">4</characteristic>
        <characteristic name="Hit" typeId="61d4-8e80-254a-ab52">3+</characteristic>
        <characteristic name="Surge" typeId="d7e0-90d3-308e-c357">Light</characteristic>
        <characteristic name="S.Die" typeId="52f3-3434-e741-a217">D3</characteristic>
        <characteristic name="Dmg" typeId="5665-56ad-b90d-ffc7">1</characteristic>
        <characteristic name="Keyword" typeId="9b72-90e3-8130-46b1"/>
      </characteristics>
    </profile>
    <profile name="Blink" id="6ca7-5027-86f4-4e3a" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">Resolve the PLACE (6) effect. Models set by this effect cannot be set up Within the Engagement Range of any Enemy Unit.</characteristic>
        <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active (1 PE)</characteristic>
      </characteristics>
    </profile>
