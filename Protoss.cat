        </profile>
        <profile name="Phase Prism" id="3f76-3ddc-d988-11c4" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">When Artanis is nominated to deploy from Reserves, it may resolve the PLACE (0) effect from another Friendly Unit. That Friendly Unit is removed from the battlefield and returned to Reserves. Artanis&apos; Activation ends.</characteristic>
            <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Passive</characteristic>
          </characteristics>
        </profile>
        <profile name="Hierarch’s Stand" id="f0d7-dc30-2a75-6334" hidden="false" typeId="07ee-ef54-fbf7-5ca9" typeName="Rules (Assault Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="97a6-bd65-3d58-17e9">When another Friendly Unit Within 8&quot; is declared as the target of a Ranged Attack and this Unit is a valid target, redirect the attack to this Unit. This Unit is eligible to make an Evade Roll against the redirected attack. This Special Ability remains active until the End of the current Activation.</characteristic>
            <characteristic name="Cost" typeId="06d2-1c49-1cfc-44f5">Reaction (1 PE)</characteristic>
          </characteristics>
        </profile>
        <profile name="Lightning Dash" id="26c9-0c0f-479e-9762" hidden="false" typeId="07ee-ef54-fbf7-5ca9" typeName="Rules (Assault Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="97a6-bd65-3d58-17e9">After this Unit resolves a successful Charge action, it may declare a second Charge action against a different Enemy Unit, ignoring the restriction on Charging while Engaged. The Devastating Charge ability does not trigger a second time.</characteristic>
            <characteristic name="Cost" typeId="06d2-1c49-1cfc-44f5">Reactive (1 PE)</characteristic>
          </characteristics>
        </profile>
        <profile name="Devastating Charge" id="ee1c-04a3-ef94-80a6" hidden="false" typeId="07ee-ef54-fbf7-5ca9" typeName="Rules (Assault Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="97a6-bd65-3d58-17e9">Immediately after this Unit completes a successful Charge, resolve the IMPACT (6) 4+ effect.</characteristic>
            <characteristic name="Cost" typeId="06d2-1c49-1cfc-44f5">Pasive</characteristic>
          </characteristics>
        </profile>
        <profile name="Twilight Blades Strike" id="56ad-6481-86e0-510f" hidden="false" typeId="7b96-11fe-e87a-e61c" typeName="Combat Weapon">
          <characteristics>
            <characteristic name="Rng" typeId="f6d9-ff21-6fe9-b821">E</characteristic>
