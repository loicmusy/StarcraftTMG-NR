        <profile name="Restoration" id="e1ee-c45e-2390-2106" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">Use when a Friendly Unit Within 4&quot; receives a DEBUFF. Remove all DEBUFFS from it.</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Reaction (1 PE)</characteristic>
          </characteristics>
        </profile>
        <profile name="Force Field" id="3bed-bc23-eac6-223a" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">Set a Force Field token Within 8&quot; in an unoccupied space. Units of Size 2 or lower cannot move across Force Fields. Models of Size 3 or more can move over it, and it&apos;s then removed.</characteristic>
            <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active (1 PE)</characteristic>
          </characteristics>
        </profile>
        <profile name="Guardian Shield" id="2271-b066-bdd9-af32" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">All Ranged Attacks targeting a Friendly Unit Within 4&quot; (Line of Sight is not required) are made with 1 fewer die in the Attack Pool.</characteristic>
