        <profile name="Our Duty is Unending" id="84e0-a4ec-c46b-d834" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">Once per Game. Select up to two of your Exhausted Tactical Cards. Return them to the Ready state.</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Active</characteristic>
          </characteristics>
        </profile>
        <profile name="Khassar de Templari" id="9f5f-9b58-8d30-4b0f" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">Instead of performing an action, select one other Friendly Biological Unit that has already been Activated this Phase. That Unit immediately performs one action available in the current Phase, then suffers NON-LETHAL DAMAGE (3).</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Active</characteristic>
          </characteristics>
        </profile>
