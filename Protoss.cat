            <characteristic name="Keyword" typeId="454d-a5c1-6c5e-8a4e">INSTANT</characteristic>
          </characteristics>
        </profile>
        <profile name="Telekinetic Push" id="cd2d-2bcf-2798-11c6" hidden="false" typeId="07ee-ef54-fbf7-5ca9" typeName="Rules (Assault Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="97a6-bd65-3d58-17e9">Set each Friendly Force Wall token Wholly Within 6&quot; of its current position.</characteristic>
