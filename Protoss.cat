        <profile name="Commander" id="d05a-5ba9-6d4a-7966" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">Treat this Unit’s Supply characteristic as increased by 1 for Controlling and Contesting Mission Markers, completing objectives, and resolving Disengage checks.</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
          </characteristics>
        </profile>
        <profile name="Force Wall" id="7615-fda2-907a-4a07" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">Set two Force Wall tokens Wholly Within 8&quot; in an unoccupied space. Units of Size 2 or lower cannot move across the Force Wall. Models of Size 3 or more can move over it, and it&apos;s then removed.</characteristic>
            <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active (1 PE)</characteristic>
          </characteristics>
        </profile>
        <profile name="Executor&apos;s Will" id="fa66-6445-7bef-44d7" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">Target two Enemy Units on the battlefield (Line of Sight is not required) and place a Faction Indicator next to each of them.
During the next Assault Phase, if either of these Units ends its Activation while its Faction Indicator remains on the battlefield, you may Activate two Friendly Units consecutively.
Remove both Faction Indicators after any Enemy Unit completes its Activation in the following Assault Phase.</characteristic>
            <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active (1 PE)</characteristic>
          </characteristics>
        </profile>
        <profile name="Khala&apos;s Gift" id="d2e4-575e-c271-dc13" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">Target another Friendly Biological Unit Within 12&quot;. Until the End of the Round, that Unit resolves its first Special Ability with the cost reduced by 1 (to a minimum of 0).</characteristic>
            <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active (0 PE)</characteristic>
          </characteristics>
        </profile>
        <profile name="Resonance Beam" id="42db-e0a8-383b-ee6f" hidden="false" typeId="e8b6-5b29-e80c-a3b3" typeName="Assault Weapon">
          <characteristics>
            <characteristic name="Rng" typeId="ebd0-74ec-d612-eac2">12</characteristic>
            <characteristic name="Tgt" typeId="ca62-f052-a905-5e3f">All</characteristic>
            <characteristic name="RoA" typeId="6594-a81b-03da-75a1">6</characteristic>
            <characteristic name="Hit" typeId="f193-00c0-1dbe-ecba">3+</characteristic>
            <characteristic name="Surge" typeId="89cf-90ae-fc8c-167a">Armoured</characteristic>
            <characteristic name="S.Die" typeId="3779-8372-ef25-255d">D3</characteristic>
