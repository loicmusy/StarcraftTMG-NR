        </profile>
        <profile name="Detection" id="d5df-50a7-a766-5da2" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">While Enemy Units are Within 8&quot; of this Unit, they lose the HIDDEN Status.</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
          </characteristics>
        </profile>
        <profile name="Source of Creep" id="4cda-992f-c35c-2eb8" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">A Friendly or Enemy Ground Zerg Unit Within 6&quot; of this Unit, counts as being ON CREEP.</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
          </characteristics>
        </profile>
        <profile name="Infestation" id="a27e-cdd6-91f3-8ba4" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">When the Supply of an Enemy Unit with the INFESTATION Status is reduced to 0, or when that Unit is Destroyed, you can apply the INFESTATION Status to another Enemy Unit Within 8&quot; of that Unit. For the purposes of resolving Special Abilities, this effect is treated as a DEBUFF.</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Reaction (0 BM)</characteristic>
          </characteristics>
        </profile>
        <profile name="Structure" id="808a-3ba7-94c9-162b" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">This Unit cannot be Activated in any Phase and cannot perform actions. Additionally, its Current Supply Value is treated as 0, and it can never Control or Contest Mission Markers, ignoring the standard Zero Supply Exception. This Unit cannot be a target of an ability, unless stated otherwise.</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
          </characteristics>
        </profile>
        <profile name="Firefly Missiles" id="94ea-95ed-c6af-81af" hidden="false" typeId="e8b6-5b29-e80c-a3b3" typeName="Assault Weapon">
          <characteristics>
            <characteristic name="Rng" typeId="ebd0-74ec-d612-eac2">14&quot;</characteristic>
            <characteristic name="Tgt" typeId="ca62-f052-a905-5e3f">Flying</characteristic>
            <characteristic name="RoA" typeId="6594-a81b-03da-75a1">8</characteristic>
            <characteristic name="Hit" typeId="f193-00c0-1dbe-ecba">4+</characteristic>
            <characteristic name="Surge" typeId="89cf-90ae-fc8c-167a">Light. Armoured</characteristic>
            <characteristic name="S.Die" typeId="3779-8372-ef25-255d">D3</characteristic>
            <characteristic name="Dmg" typeId="a082-2247-4a81-d1e2">1</characteristic>
            <characteristic name="Keyword" typeId="454d-a5c1-6c5e-8a4e">ANTI-EVADE (1)</characteristic>
          </characteristics>
        </profile>
        <profile name="Ocular Overwatch" id="d03b-d609-2041-007e" hidden="false" typeId="07ee-ef54-fbf7-5ca9" typeName="Rules (Assault Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="97a6-bd65-3d58-17e9">When an Enemy Flying Unit ends its Activation Within 14&quot;. This Unit immediately performs a Ranged Attack against that Enemy Unit.</characteristic>
            <characteristic name="Cost" typeId="06d2-1c49-1cfc-44f5">Reaction (0 BM)</characteristic>
          </characteristics>
        </profile>
      </profiles>
