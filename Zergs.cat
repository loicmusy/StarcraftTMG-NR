    <profile name="Zerg Creep" id="ace7-328b-a155-9023" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">During Army Building, select exactly one Creep Card and add it to their Army List, paying its listed cost (if any).</characteristic>
        <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
      </characteristics>
    </profile>
    <profile name="Burrow Ambush" id="6a03-719a-49fe-1fd4" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">When this Unit is nominated to deploy from the Reserves, it may resolve the PLACE (18) effect from the controlling player&apos;s Entry Edge. No model may be set Within 10&quot; of any Enemy model. This Unit&apos;s Activation ends.</characteristic>
        <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Passive</characteristic>
      </characteristics>
    </profile>
    <profile name="Raptor Strain" id="948d-89c9-a604-a463" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">This Unit can move through IMPASSABLE TERRAIN of Size 4 or less and change elevation without using ACCESS POINTS.</characteristic>
        <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
      </characteristics>
    </profile>
    <profile name="Adrenal Overload" id="fa36-4feb-4201-a6e0" hidden="false" typeId="07ee-ef54-fbf7-5ca9" typeName="Rules (Assault Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="97a6-bd65-3d58-17e9">This Unit gains a +1 Modifier to all IMPACT Hit Rolls.</characteristic>
        <characteristic name="Cost" typeId="06d2-1c49-1cfc-44f5">Active (1 BM)</characteristic>
      </characteristics>
    </profile>
    <profile name="Metabolic Boost" id="48be-d8b9-d2f4-1f6b" hidden="false" typeId="07ee-ef54-fbf7-5ca9" typeName="Rules (Assault Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="97a6-bd65-3d58-17e9">When determining Charge Distance for this Unit, roll 2D6 instead of D6 and use the higher result to add to the Unit’s Speed characteristic.</characteristic>
        <characteristic name="Cost" typeId="06d2-1c49-1cfc-44f5">Active (1 BM)</characteristic>
      </characteristics>
    </profile>
