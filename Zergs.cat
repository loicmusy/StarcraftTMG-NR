        </profile>
        <profile name="Spread Infestation" id="9681-8548-30de-75bb" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">Target an Enemy Unit Within 8&quot;. The targeted Unit gains the INFESTATION Status. For the purposes of resolving Special Abilities, this effect is treated as a DEBUFF.</characteristic>
            <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active (1 BM)</characteristic>
          </characteristics>
        </profile>
        <profile name="Admiral of the Infested" id="fe40-c539-2563-495e" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">Target an Enemy Unit Within 8&quot; that has the INFESTATION Status. That Unit counts as Activated in this Phase (set an Activation Marker next to it) and remove the INFESTATION Status from that Unit. You may target any non-Unique Friendly Unit with the Infested Combat Tag that is Within 8&quot; of the previously targeted Enemy Unit. Remove the Activation Marker from that targeted Friendly Unit.</characteristic>
            <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active (1 BM)</characteristic>
          </characteristics>
        </profile>
        <profile name="Corrosive Blast" id="9022-ae35-444b-0f95" hidden="false" typeId="e8b6-5b29-e80c-a3b3" typeName="Assault Weapon">
