        </profile>
        <profile name="Burrow Ambush" id="8933-1d59-9c1f-d5d8" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">When this Unit is nominated to deploy from the Reserves, it may resolve the PLACE (18) effect from the controlling player’s Entry Edge. No model may be set Within 10&quot; of any Enemy model. This Unit’s Activation ends.</characteristic>
            <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Passive</characteristic>
          </characteristics>
        </profile>
        <profile name="Spread Infestation" id="e476-82e8-7914-fa5f" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">Target an Enemy Unit Within 8&quot;. The targeted Unit gains the INFESTATION Status. For the purposes of resolving Special Abilities, this effect is treated as a DEBUFF.</characteristic>
            <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active (1 BM)</characteristic>
          </characteristics>
        </profile>
        <profile name="Devastating Charge" id="57c1-303e-b6ca-8289" hidden="false" typeId="07ee-ef54-fbf7-5ca9" typeName="Rules (Assault Phase)">
          <characteristics>
