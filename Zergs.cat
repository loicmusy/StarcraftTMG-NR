    <profile name="Burrow" id="4a96-a1ac-0461-aa14" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">If this Unit is Unengaged, it gains or loses the Burrowed Status.</characteristic>
        <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Active (2 BM)</characteristic>
      </characteristics>
    </profile>
    <profile name="Glial Reconstitution" id="c5d5-beb9-00b6-d18c" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">This Unit gains BUFF SPEED (1), or BUFF SPEED (2) if the Unit is ON CREEP.</characteristic>
        <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active (1 BM)</characteristic>
      </characteristics>
    </profile>
    <profile name="Hydriodic Bile" id="7f8e-efeb-4683-3010" hidden="false" typeId="07ee-ef54-fbf7-5ca9" typeName="Rules (Assault Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="97a6-bd65-3d58-17e9">This Unit&apos;s Acid Saliva weapon gains Surge Type: Light, and S Dice: D3+1.</characteristic>
        <characteristic name="Cost" typeId="06d2-1c49-1cfc-44f5">Passive</characteristic>
      </characteristics>
    </profile>
