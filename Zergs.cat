        <profile name="Detonation" id="3607-1dff-0795-c113" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">Immediately before any models in this Unit are Destroyed, Enemy Units Within 2&quot; suffer HITS 1 (2) for each model in this Unit that will be Destroyed.</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Reaction (1 BM)</characteristic>
