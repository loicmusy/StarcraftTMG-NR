    <profile name="Creep Removal" id="dc56-7a7c-492a-7eb9" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">If an Enemy Unit ends a Move, Deploy, Run, Charge or Disengage action Within 1&quot; of a Friendly Creep Tumor token, remove that token from the battlefield.</characteristic>
        <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
      </characteristics>
    </profile>
    <profile name="Creep Spread" id="8cca-b3c0-8237-ab91" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">Set a Creep Tumor token on the battlefield Within 6&quot; (Line of Sight is not required) of either a Friendly Entry Edge or an existing Friendly Creep Tumor token.</characteristic>
        <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active</characteristic>
      </characteristics>
    </profile>
    <profile name="Feral Rage" id="0489-6ed9-bca1-be9c" hidden="false" typeId="f61d-0471-085d-248c" typeName="Rules (Combat Phase)">
