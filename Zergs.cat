        <characteristic name="Supply" typeId="4fa8-90ab-7d11-c8e3">1: 0 | 2-3: 1</characteristic>
      </characteristics>
    </profile>
    <profile name="Burrow" id="4a96-a1ac-0461-aa14" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">If this Unit is Unengaged, it gains or loses the Burrowed Status.</characteristic>
        <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Active (2 BM)</characteristic>
      </characteristics>
    </profile>
    <profile name="Glial Reconstitution" id="c5d5-beb9-00b6-d18c" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">This Unit gains BUFF SPEED (1), or BUFF SPEED (2) if the Unit is ON CREEP.</characteristic>
        <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active (1 BM)</characteristic>
      </characteristics>
    </profile>
    <profile name="Hydriodic Bile" id="7f8e-efeb-4683-3010" hidden="false" typeId="07ee-ef54-fbf7-5ca9" typeName="Rules (Assault Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="97a6-bd65-3d58-17e9">This Unit&apos;s Acid Saliva weapon gains Surge Type: Light, and S Dice: D3+1.</characteristic>
        <characteristic name="Cost" typeId="06d2-1c49-1cfc-44f5">Passive</characteristic>
      </characteristics>
    </profile>
    <profile name="Claws" id="9991-19ca-327a-9240" hidden="false" typeId="7b96-11fe-e87a-e61c" typeName="Combat Weapon">
      <comment>Roach(ling)</comment>
      <characteristics>
        <characteristic name="Rng" typeId="f6d9-ff21-6fe9-b821">E</characteristic>
        <characteristic name="Tgt" typeId="0bf8-6c63-e593-8417">Ground</characteristic>
        <characteristic name="RoA" typeId="af32-03e6-6c32-3580">2</characteristic>
        <characteristic name="Hit" typeId="61d4-8e80-254a-ab52">4+</characteristic>
        <characteristic name="Surge" typeId="d7e0-90d3-308e-c357"/>
        <characteristic name="S.Die" typeId="52f3-3434-e741-a217"/>
        <characteristic name="Dmg" typeId="5665-56ad-b90d-ffc7">1</characteristic>
        <characteristic name="Keyword" typeId="9b72-90e3-8130-46b1"/>
      </characteristics>
    </profile>
    <profile name="Living Glob of Tissue" id="0e98-3f8d-2fc8-74f9" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">Creep Tumor tokens have STAY IN PLAY and DISPLACEMENT.</characteristic>
        <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
      </characteristics>
    </profile>
    <profile name="Creep Removal" id="dc56-7a7c-492a-7eb9" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">If an Enemy Unit ends a Move, Deploy, Run, Charge or Disengage action Within 1&quot; of a Friendly Creep Tumor token, remove that token from the battlefield.</characteristic>
        <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
      </characteristics>
    </profile>
    <profile name="Creep Spread" id="8cca-b3c0-8237-ab91" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">Set a Creep Tumor token on the battlefield Within 6&quot; (Line of Sight is not required) of either a Friendly Entry Edge or an existing Friendly Creep Tumor token.</characteristic>
        <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active</characteristic>
      </characteristics>
    </profile>
    <profile name="Feral Rage" id="0489-6ed9-bca1-be9c" hidden="false" typeId="f61d-0471-085d-248c" typeName="Rules (Combat Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="b94b-6a13-1240-6b8b">The active Unit’s first Close Combat Weapon used gains PRECISION (2).</characteristic>
        <characteristic name="Cost" typeId="6f0c-b621-2f03-fe52">Active</characteristic>
      </characteristics>
    </profile>
    <profile name="Regeneration" id="8818-270f-f343-09e9" hidden="false" typeId="07ee-ef54-fbf7-5ca9" typeName="Rules (Assault Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="97a6-bd65-3d58-17e9">When this Unit becomes Activated, if it has the Burrowed Status, resolve the HEAL (2) effect.</characteristic>
        <characteristic name="Cost" typeId="06d2-1c49-1cfc-44f5">Passive</characteristic>
      </characteristics>
    </profile>
