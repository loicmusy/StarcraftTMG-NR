            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
          </characteristics>
        </profile>
        <profile name="Source of Creep" id="03b2-70de-f0ea-221d" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">A Friendly or Enemy Ground Zerg Unit Within 6&quot; of this Unit, counts as being ON CREEP.</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
          </characteristics>
        </profile>
        <profile name="Detection" id="40c0-c8f1-22b8-32c6" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">While Enemy Units are Within 6&quot; of this Unit, they lose the HIDDEN Status.</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
          </characteristics>
        </profile>
        <profile name="Burrow Ambush" id="a550-2e02-f38a-743e" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">When this Unit is nominated to deploy from the Reserves, it may resolve the PLACE (18) effect from the controlling player&apos;s Entry Edge. No model may be set Within 10&quot; of any Enemy model. This Unit&apos;s Activation ends.</characteristic>
            <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Passive</characteristic>
          </characteristics>
        </profile>
        <profile name="Bombard" id="fba8-a3f0-47f8-ae64" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">Set a Bile Bomb token on the battlefield Within 24&quot; of this Unit. When this Unit resolves a Ranged Attack using the Bile Bomb weapon profile this Round, it may choose to ignore the weapon&apos;s standard Range characteristic. If it does, it may target an Enemy Unit that is Within 3&quot; of that token (Line of Sight is not required), ignoring the HIDDEN Status. After the attack is fully resolved, remove the Bile Bomb token from the battlefield. When the Bile Bomb token is about to be removed, set a Creep Tumor token in base-to-base contact with it. The Bile Bomb token has DISPLACEMENT.</characteristic>
            <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active (1 BM)</characteristic>
          </characteristics>
        </profile>
        <profile name="Indomitable" id="f032-c5a6-70cc-1830" hidden="false" typeId="07ee-ef54-fbf7-5ca9" typeName="Rules (Assault Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="97a6-bd65-3d58-17e9">While Engaged, this Unit may target and be targeted by Unengaged Enemy Units. In both cases, the defending Unit gains an Evade Roll against those attacks.</characteristic>
            <characteristic name="Cost" typeId="06d2-1c49-1cfc-44f5">Passive</characteristic>
          </characteristics>
        </profile>
        <profile name="Bile Bomb" id="3cd2-76a2-7fdc-fe9c" hidden="false" typeId="e8b6-5b29-e80c-a3b3" typeName="Assault Weapon">
          <characteristics>
            <characteristic name="Rng" typeId="ebd0-74ec-d612-eac2">12</characteristic>
            <characteristic name="Tgt" typeId="ca62-f052-a905-5e3f">Ground</characteristic>
            <characteristic name="RoA" typeId="6594-a81b-03da-75a1">6</characteristic>
            <characteristic name="Hit" typeId="f193-00c0-1dbe-ecba">3+</characteristic>
            <characteristic name="Surge" typeId="89cf-90ae-fc8c-167a">Light, Armoured</characteristic>
            <characteristic name="S.Die" typeId="3779-8372-ef25-255d">D3</characteristic>
            <characteristic name="Dmg" typeId="a082-2247-4a81-d1e2">1</characteristic>
            <characteristic name="Keyword" typeId="454d-a5c1-6c5e-8a4e">PIERCE Armoured (2), PINPOINT</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
