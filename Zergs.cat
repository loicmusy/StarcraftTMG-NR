      </characteristics>
    </profile>
    <profile name="Raptor Strain" id="948d-89c9-a604-a463" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
      <characteristics>
        <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">This Unit can move through IMPASSABLE TERRAIN of Size 4 or less and change elevation without using ACCESS POINTS.</characteristic>
