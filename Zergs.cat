          <characteristics>
            <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">If there is no Friendly Infested Missile Turret on the battlefield, set a Friendly Infested Missile Turret Unit anywhere on the GROUND LEVEL of the battlefield more than 10&quot; away from any Enemy model. This Round, the Missile Turret is not eligible to use its Special Abilities (excluding Structure).</characteristic>
            <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active</characteristic>
          </characteristics>
        </profile>
