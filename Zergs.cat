          </characteristics>
        </profile>
        <profile name="Large" id="be76-fc95-a902-32f8" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">When this Unit&apos;s Leading Model moves, it cannot pass through physical gaps smaller than 3&quot; wide, regardless of its size. If the Leading Model&apos;s path of travel passes through, or any model in this Unit ends its movement on a Size 0 or Size 1 Impassible Terrain piece (excluding Tokens) during any movement action, that terrain piece is immediately removed from the game.</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
          </characteristics>
        </profile>
        <profile name="Heavy Plating" id="438f-4cab-f12d-f90d" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">When this Unit resolves an Armour Roll, it gains TOUGH (1), provided it does not currently have the SIEGE MODE Status.</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
          </characteristics>
        </profile>
        <profile name="Twin Cannon" id="32d9-20a3-a10e-f9cd" hidden="false" typeId="e8b6-5b29-e80c-a3b3" typeName="Assault Weapon">
          <characteristics>
            <characteristic name="Rng" typeId="ebd0-74ec-d612-eac2">12&quot;</characteristic>
            <characteristic name="Tgt" typeId="ca62-f052-a905-5e3f">Ground</characteristic>
            <characteristic name="RoA" typeId="6594-a81b-03da-75a1">8</characteristic>
            <characteristic name="Hit" typeId="f193-00c0-1dbe-ecba">3+</characteristic>
            <characteristic name="Surge" typeId="89cf-90ae-fc8c-167a">Armoured</characteristic>
            <characteristic name="S.Die" typeId="3779-8372-ef25-255d">D6</characteristic>
            <characteristic name="Dmg" typeId="a082-2247-4a81-d1e2">1</characteristic>
            <characteristic name="Keyword" typeId="454d-a5c1-6c5e-8a4e">PIERCE Armoured (2)</characteristic>
          </characteristics>
        </profile>
        <profile name="Shock Cannon" id="b39f-13a8-4dc4-7c27" hidden="false" typeId="e8b6-5b29-e80c-a3b3" typeName="Assault Weapon">
          <characteristics>
            <characteristic name="Rng" typeId="ebd0-74ec-d612-eac2">18&quot;</characteristic>
            <characteristic name="Tgt" typeId="ca62-f052-a905-5e3f">Ground</characteristic>
            <characteristic name="RoA" typeId="6594-a81b-03da-75a1">BT+4</characteristic>
            <characteristic name="Hit" typeId="f193-00c0-1dbe-ecba">4+</characteristic>
            <characteristic name="Surge" typeId="89cf-90ae-fc8c-167a">Light, Armoured</characteristic>
            <characteristic name="S.Die" typeId="3779-8372-ef25-255d">BT</characteristic>
            <characteristic name="Dmg" typeId="a082-2247-4a81-d1e2">1</characteristic>
            <characteristic name="Keyword" typeId="454d-a5c1-6c5e-8a4e">SIEGE MODE Status</characteristic>
          </characteristics>
        </profile>
        <profile name="Indomitable" id="1266-cc88-f378-bdb2" hidden="false" typeId="07ee-ef54-fbf7-5ca9" typeName="Rules (Assault Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="97a6-bd65-3d58-17e9">While Engaged, this Unit may target and be targeted by Unengaged Enemy Units. In both cases, the defending Unit gains an Evade Roll against those attacks.</characteristic>
            <characteristic name="Cost" typeId="06d2-1c49-1cfc-44f5">Passive</characteristic>
          </characteristics>
        </profile>
        <profile name="Point Blank" id="5a18-6004-7697-8abd" hidden="false" typeId="07ee-ef54-fbf7-5ca9" typeName="Rules (Assault Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="97a6-bd65-3d58-17e9">While this Unit has the SIEGE MODE Status, it cannot target Enemy Units it is Engaged with.</characteristic>
            <characteristic name="Cost" typeId="06d2-1c49-1cfc-44f5">Passive</characteristic>
          </characteristics>
        </profile>
        <profile name="Aftershock Rounds" id="4c5d-a692-6337-f8f5" hidden="false" typeId="07ee-ef54-fbf7-5ca9" typeName="Rules (Assault Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="97a6-bd65-3d58-17e9">When this Unit has the SIEGE MODE Status, its Damage characteristic is treated as equal to the Size characteristic of the current target Unit (to a minimum of 1).</characteristic>
            <characteristic name="Cost" typeId="06d2-1c49-1cfc-44f5">Passive</characteristic>
