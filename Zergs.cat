          </characteristics>
        </profile>
        <profile name="Plagued Munitions" id="f28e-d4a1-0b13-bb70" hidden="false" typeId="07ee-ef54-fbf7-5ca9" typeName="Rules (Assault Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="97a6-bd65-3d58-17e9">Immediately after an attack with the Infested C-14 Rifle, if the attacked Unit suffered Damage, it also suffers NON-LETHAL Damage (1).</characteristic>
