        <profile name="Gestate Dark Swarm" id="bd30-3bce-6732-7d62" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">Set a Dark Swarm token in an unoccupied space Within 4&quot; and Line of Sight of this Unit. The Dark Swarm token has DISPLACEMENT.</characteristic>
