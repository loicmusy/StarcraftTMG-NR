        <profile name="Live for the Swarm!" id="92a3-d2ae-28e1-f316" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">When this Unit attacks an Enemy Unit with the INFESTATION Status or a Unit Within 6&quot; of any Source of Creep or Creep Tumor, its Infested C-14 Rifle and all Close Combat Attacks gain PRECISION (2).</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
          </characteristics>
        </profile>
        <profile name="Detonation" id="3434-e46b-cf0d-c744" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">Immediately before any models in this Unit are Destroyed, Enemy Units Within 2&quot; suffer HITS (1) 1 for each model in this Unit that will be Destroyed.</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
