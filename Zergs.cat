      <characteristics>
        <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">Creep Tumor tokens have STAY IN PLAY and DISPLACEMENT.</characteristic>
        <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
