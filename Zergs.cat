        <profile name="Infested Siege Tank" id="3d32-1596-c142-79af" hidden="false" typeId="18be-d8b9-8024-4925" typeName="Unit">
          <characteristics>
            <characteristic name="Shd" typeId="4301-e83c-7226-741a"></characteristic>
