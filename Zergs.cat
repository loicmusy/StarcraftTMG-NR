        <profile name="Wild Mutation" id="0f36-b5fc-8590-023d" hidden="false" typeId="a305-fb8b-8be3-f0fe" typeName="Rules (Any Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">If the active unit is ON CREEP, the Unit gains BUFF Speed (1) and its first Weapon used gains PRECISION (1).</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Active</characteristic>
          </characteristics>
        </profile>
        <profile name="Omega Network" id="7f67-6479-faf2-1e87" hidden="false" typeId="ec1d-63b8-de26-1894" typeName="Rules (Movement Phase)">
          <characteristics>
            <characteristic name="Effect" typeId="1c06-5502-fb5a-616e">If there is no Friendly Omega Worm on the battlefield, set a Friendly Omega Worm Unit anywhere on GROUND LEVEL of the battlefield, more than 10&quot; away from any Enemy model. This Round, the Omega Worm is not eligible to use its Special Abilities (excluding Structure).</characteristic>
            <characteristic name="Cost" typeId="e11e-d579-0142-8de4">Active</characteristic>
          </characteristics>
        </profile>
      </profiles>
