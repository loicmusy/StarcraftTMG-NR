          <characteristics>
            <characteristic name="Effect" typeId="616e-c7be-abff-a2bf">During Army Building, select exactly one Virus Card and add it to your Army List, paying its listed cost (if any).</characteristic>
            <characteristic name="Cost" typeId="1696-5ea7-559b-bb8b">Passive</characteristic>
          </characteristics>
