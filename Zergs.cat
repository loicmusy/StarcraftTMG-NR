        <profile name="Zagara" id="5a5f-135e-1bb2-7c92" hidden="false" typeId="18be-d8b9-8024-4925" typeName="Unit">
          <characteristics>
            <characteristic name="Shd" typeId="4301-e83c-7226-741a">-</characteristic>
            <characteristic name="Spd" typeId="1b39-d395-b125-7ea9">7</characteristic>
